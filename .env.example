# Export these variables in your shell; the binary does not load .env files.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://community:community_local@127.0.0.1:5432/community?sslmode=disable
AUTH_MODE=development
# Replace with a randomly generated secret of at least 32 characters.
DEV_AUTH_TOKEN=
# Optional local-development password for seeded admin accounts (12-128 chars).
# Keep this secret in your shell only; do not commit real credentials.
DEV_ADMIN_PASSWORD=
# Optional local platform admin password (12-128 chars).
DEV_PLATFORM_ADMIN_PASSWORD=
# Production OIDC: APP_ENV=production, AUTH_MODE=oidc, and HTTPS issuer/client audience.
OIDC_ISSUER=
OIDC_AUDIENCE=
# Production administrator-provisioned accounts: APP_ENV=production, AUTH_MODE=password.
# Set a random secret with at least 32 characters; never reuse a development token.
AUTH_SECRET=
# Temporary bootstrap only: provision-user reads the first platform admin password from this variable.
INITIAL_ACCOUNT_PASSWORD=
